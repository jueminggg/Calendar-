# Copy this file to .env (local dev) and set the same values as environment
# variables in your hosting provider (e.g. Vercel) for production.

# --- Core (required) ---

# Postgres connection string. Get one for free from Neon or Supabase.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public&sslmode=require"

# The public URL this app is deployed at, no trailing slash. Used to build
# OAuth redirect URIs and webhook callback URLs. For local dev this can stay
# http://localhost:3000, but Google/Microsoft OAuth and webhooks require a
# real HTTPS URL once deployed.
APP_URL="http://localhost:3000"

# Random secrets used to sign session cookies and encrypt stored OAuth
# tokens / CalDAV passwords at rest. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=""
ENCRYPTION_KEY=""

# A password you make up yourself. Required to create an account on
# /signup, so a stranger who finds your URL can't sign themselves up.
SIGNUP_SECRET=""

# --- Google Calendar (optional, only needed if you connect Google) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Microsoft / Outlook (optional, only needed if you connect Outlook) ---
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Leave unset to allow any Microsoft account (personal + work/school), or
# set to your Azure AD tenant ID to restrict sign-in to one organization.
MICROSOFT_TENANT_ID=""
# Any random string; verifies Graph webhook notifications are really from
# Microsoft. Generate with: openssl rand -hex 16
MICROSOFT_WEBHOOK_SECRET=""

# --- Cron (optional but recommended once deployed) ---
# Protects /api/cron/sync from being called by randoms. Generate with:
#   openssl rand -hex 16
CRON_SECRET=""

# --- Screenshot import (optional, only needed for the "Import screenshot" button) ---
# Lets you add events from a screenshot of any calendar you can view but can't
# connect via OAuth (e.g. a work Outlook calendar your IT department has locked
# down). Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
