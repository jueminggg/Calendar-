// Prisma schema for the cross-platform calendar sync app.
// Learn more: https://pris.ly/d/prisma-schema

// The classic prisma-client-js generator outputs into node_modules, where
// Next.js/Vercel already special-case @prisma/client for serverless
// deployment (it's in their built-in serverExternalPackages list). The
// newer prisma-client generator's custom output path doesn't get that
// same treatment, which is what caused the query-engine-not-found errors.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Provider {
  GOOGLE
  MICROSOFT
  APPLE
}

enum EventSource {
  GOOGLE
  MICROSOFT
  APPLE
  NATIVE
}

enum ConnectionStatus {
  ACTIVE
  ERROR
  DISCONNECTED
}

enum EventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

enum Priority {
  LOW
  MED
  HIGH
}

enum NotificationType {
  INVITE
  UPDATE
  CANCELLATION
  CONNECTION_ERROR
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  timezone     String   @default("UTC")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Daily planning reminders ("HH:MM", interpreted in the user's own timezone above)
  remindersEnabled          Boolean   @default(false)
  morningReminderTime       String    @default("07:00")
  eveningReminderTime       String    @default("20:00")
  lastMorningReminderSentAt DateTime?
  lastEveningReminderSentAt DateTime?

  // If false, editing/deleting a Google/Outlook/iCloud-sourced event in this
  // app only updates our own copy — it never calls back out to the provider.
  // Native events and pulling changes IN from providers are unaffected.
  externalWriteEnabled Boolean @default(true)

  // Telegram bot linking + daily agenda messages ("HH:MM" in the timezone above)
  telegramChatId                  String?   @unique
  telegramLinkCode                String?   @unique
  telegramLinkCodeExpiresAt       DateTime?
  telegramMorningAgendaEnabled    Boolean   @default(false)
  telegramMorningAgendaTime       String    @default("08:00")
  telegramEveningAgendaEnabled    Boolean   @default(false)
  telegramEveningAgendaTime       String    @default("21:00")
  lastTelegramMorningAgendaSentAt DateTime?
  lastTelegramEveningAgendaSentAt DateTime?

  connections       CalendarConnection[]
  events            Event[]
  notifications     Notification[]
  tasks             Task[]
  ideas             Idea[]
  telegramDrafts    TelegramDraft[]
  pushSubscriptions PushSubscription[]
}

/// A pending "confirm or cancel" action created by the Telegram bot's
/// natural-language event flow when a scheduling clash is found. The
/// inline buttons' callback_data references this row's id — Telegram
/// limits callback_data to 64 bytes, too small to hold the event payload.
model TelegramDraft {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // "create_event" for now
  payload   Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

/// A quick note captured by messaging the Telegram bot (any message that
/// isn't a recognized command) — for jotting down social media/content
/// ideas on the go. Listed back via the /ideas Telegram command.
model Idea {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// One browser/device's Web Push subscription, so a user can have several
/// (phone, laptop, iPad) and reminders/alerts go out to all of them.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.Text
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A single day's to-do item, optionally time-blocked (startAt/endAt) so it
/// can double as a plan for the day rather than just a checklist.
model Task {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  notes     String?
  // The day this to-do belongs to, stored as that day's midnight UTC. Null
  // means "flexible" — a goal/session with a deadline but no day assigned
  // yet, eligible to be picked up by Plan my day (or a Telegram "what
  // should I do" query) on whichever day has room before the deadline.
  // Gets set the first time it's actually scheduled.
  date      DateTime?
  startAt   DateTime?
  endAt     DateTime?
  done      Boolean   @default(false)
  order     Int       @default(0)

  // Used by "Plan my day" to estimate/prioritize backlog tasks when slotting
  // them into free time between calendar events.
  estimatedMinutes Int?
  deadline         DateTime?
  priority         Priority  @default(MED)
  location         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, date])
}

/// One connected external account (a Google account, a Microsoft account, or an
/// iCloud CalDAV credential). A single connection can expose multiple calendars.
model CalendarConnection {
  id       String           @id @default(cuid())
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider Provider
  label    String
  status   ConnectionStatus @default(ACTIVE)
  lastSyncAt   DateTime?
  lastError    String?

  // OAuth (Google / Microsoft)
  accessToken  String?  @db.Text
  refreshToken String?  @db.Text // Google: refresh token. Microsoft: serialized MSAL token cache.
  tokenExpiresAt DateTime?
  scope        String?
  providerAccountId String? // Microsoft: MSAL homeAccountId, needed for acquireTokenSilent

  // CalDAV (Apple iCloud)
  caldavUsername  String?
  caldavPassword  String? @db.Text // encrypted at rest, see src/lib/crypto.ts
  caldavServerUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calendars       CalendarList[]
  webhookChannels WebhookChannel[]

  @@unique([userId, provider, label])
  @@index([userId])
}

/// An individual calendar within a connection (e.g. "Work", "Family", "Holidays").
model CalendarList {
  id           String             @id @default(cuid())
  connectionId String
  connection   CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalId   String             // Google calendarId / Graph calendar id / CalDAV calendar URL
  name         String
  color        String?
  isPrimary    Boolean            @default(false)
  enabled      Boolean            @default(true)

  // Sync cursor, provider-specific: Google syncToken, Graph deltaLink, CalDAV ctag/sync-token
  syncCursor String?   @db.Text
  lastSyncAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  @@unique([connectionId, externalId])
  @@index([connectionId])
}

/// A calendar event. Either mirrored from an external provider (source != NATIVE,
/// externalId set) or created directly in this app (source == NATIVE).
model Event {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarListId String?
  calendarList   CalendarList? @relation(fields: [calendarListId], references: [id], onDelete: Cascade)

  source     EventSource
  externalId String? // provider's event id, null for NATIVE events
  icalUid    String? // iCalendar UID, correlates the same event across providers/invites

  title       String
  description String?     @db.Text
  location    String?
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean     @default(false)
  timezone    String      @default("UTC")
  status      EventStatus @default(CONFIRMED)

  organizer         String?
  attendees         Json?   // [{ email, name, responseStatus }]
  recurrenceRule    String?
  recurringEventId  String? // externalId of the parent recurring event, if this is an instance

  providerUpdatedAt DateTime? // provider's own "last modified", used to detect edits
  providerEtag      String?
  raw               Json?     // original provider payload, kept for debugging/re-sync

  // Per-event custom reminder, independent of the daily planning reminders.
  // Minutes before startAt to send a push/Telegram alert; null = no custom reminder.
  reminderMinutesBefore Int?
  reminderSentAt        DateTime?

  // Only meaningful for source == NATIVE: how the event got into the app,
  // for display purposes (e.g. "Screenshot" vs "Manually added"). Null means
  // typed directly into the app. "screenshot" means added via /events/import
  // after Claude read it out of a pasted/uploaded image.
  importedVia String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]

  @@unique([calendarListId, externalId])
  @@index([userId, startAt])
  @@index([icalUid])
}

/// A subscription to provider push notifications (Google watch channel / Microsoft
/// Graph subscription). Apple/CalDAV has no push mechanism and is polled instead.
model WebhookChannel {
  id           String             @id @default(cuid())
  connectionId String
  connection   CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  provider     Provider
  channelId    String // Google channel id / Graph subscription id
  resourceId   String? // Google resourceId
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([connectionId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String?
  event     Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  type      NotificationType
  title     String
  body      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}
